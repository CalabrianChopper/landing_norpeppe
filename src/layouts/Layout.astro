---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, CALABRIA } from '../data/site';
import { seo, keywords, faq } from '../data/seo';
import { prossimi, passati, urlEvento, type Evento } from '../data/eventi';
import { viaggiMondo } from '../data/viaggiMondo';
import { totalePaesi, continenti } from '../data/paesi';
import { formato } from '../data/viaggi';

interface Props {
  title?: string;
  description?: string;
  /** Polo cromatico di default della pagina. */
  pole?: 'mondo' | 'kalabria';
  /** Percorso della pagina a partire dalla radice, es. '/kalabria/tiriolo/'. */
  path?: string;
  /** Immagine per Open Graph, se diversa da quella di default. */
  immagine?: string;
  /**
   * Nodi schema.org specifici della pagina. Organizzazione, persona e sito
   * ci sono sempre; questi si aggiungono. Se non passi niente valgono quelli
   * della home (pagina, FAQ e i due elenchi di viaggi).
   */
  nodi?: unknown[];
  /** Pagine di servizio: fuori dai motori di ricerca. */
  noindex?: boolean;
  /** Quale elenco di viaggi emettere come ItemList: Calabria o mondo. Senza, la FAQ della home. */
  elenco?: 'kalabria' | 'mondo';
}

const {
  title = seo.title,
  description = seo.description,
  pole = 'mondo',
  path = '/',
  immagine,
  nodi,
  noindex = false,
  elenco,
} = Astro.props;

const urlBase = seo.url.replace(/\/$/, '');
const home = `${urlBase}/`;
const canonical = `${urlBase}${path}`;
const ogImage = `${urlBase}${immagine ?? seo.ogImage}`;

// ---- Dati strutturati (schema.org) ------------------------------------------
// Un solo grafo: organizzazione, persona, sito, FAQ e le offerte (viaggi ed
// escursioni) collegate tra loro con @id. È quello che leggono Google e i
// motori generativi per capire chi sei e cosa offri, e dove.
const idOrg = `${urlBase}/#organizzazione`;
const idPersona = `${urlBase}/#giuseppe-lupis`;

const luogoCalabria = {
  '@type': 'Place',
  name: 'Calabria',
  address: { '@type': 'PostalAddress', addressRegion: 'Calabria', addressCountry: 'IT' },
  geo: { '@type': 'GeoCoordinates', latitude: CALABRIA.lat, longitude: CALABRIA.lon },
};

// Le uscite calabresi con una pagina propria puntano lì: è l'indirizzo che
// vogliamo far indicizzare. Le altre restano ancorate alla sezione.
const viaggio = (e: Evento, area: 'Calabria' | 'mondo') => {
  const pagina = area === 'Calabria' ? urlEvento(e) : undefined;
  const ancora = area === 'Calabria' ? 'kalabria/#calendario-kalabria' : 'mondo/#calendario';
  return {
  '@type': 'TouristTrip',
  name: e.titolo,
  description: e.sintesi,
  url: pagina ? `${urlBase}${pagina}` : `${home}${ancora}`,
  touristType: area === 'Calabria' ? ['trekking in Calabria', 'viaggi in Calabria'] : ['viaggi di gruppo', 'viaggi di gruppo organizzati'],
  itinerary: { '@type': 'Place', name: e.luogo },
  provider: { '@id': idOrg },
  ...(area === 'Calabria' ? { areaServed: luogoCalabria } : {}),
  };
};

// Nodi sempre presenti: chi siamo, chi sono io, che sito è questo.
const nodiSempre = [
    {
      '@type': ['TravelAgency', 'Organization'],
      '@id': idOrg,
      name: site.brand,
      alternateName: ['Xploring Kalabria'],
      url: home,
      logo: `${urlBase}/images/logo.png`,
      image: ogImage,
      description: seo.description,
      slogan: site.claim,
      email: site.email,
      telephone: site.telefono,
      founder: { '@id': idPersona },
      areaServed: [luogoCalabria, { '@type': 'Place', name: 'Mondo' }],
      knowsAbout: [...keywords, 'escursioni in Calabria', 'viaggi avventura'],
      sameAs: [site.social.instagram, site.social.facebook, site.social.tiktok],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'prenotazioni',
        telephone: site.telefono,
        email: site.email,
        url: site.social.whatsapp,
        availableLanguage: 'it',
      },
      makesOffer: [
        {
          '@type': 'Offer',
          name: 'Viaggi di gruppo organizzati nel mondo',
          description: `Viaggi di gruppo in ${formato.gruppo}, ${formato.partenzeAnno}, verso ${totalePaesi} paesi in ${continenti.length} continenti già percorsi da Giuseppe Lupis.`,
          url: `${home}mondo/`,
        },
        {
          '@type': 'Offer',
          name: 'Viaggi in Calabria: trekking, escursioni ed eventi',
          description: `Trekking in Calabria, canyon, rafting, borghi e serate. ${passati.length} uscite già fatte, ${prossimi.length} in arrivo.`,
          url: `${home}kalabria/`,
          areaServed: luogoCalabria,
        },
      ],
    },
    {
      '@type': 'Person',
      '@id': idPersona,
      name: seo.persona.nome,
      jobTitle: seo.persona.ruolo,
      description:
        'Calabrese, viaggiatore e storyteller. Organizza viaggi di gruppo nel mondo e il calendario Xploring Kalabria di trekking ed escursioni in Calabria.',
      image: `${urlBase}/images/giuseppe-portrait.jpg`,
      url: home,
      homeLocation: luogoCalabria,
      worksFor: { '@id': idOrg },
      sameAs: [site.social.instagram, site.social.facebook, site.social.tiktok],
    },
    {
      '@type': 'WebSite',
      '@id': `${urlBase}/#sito`,
      url: home,
      name: site.brand,
      inLanguage: seo.lingua,
      publisher: { '@id': idOrg },
      keywords: keywords.join(', '),
    },
];

// La pagina vera e propria, uguale per tutte.
const nodoPagina = {
  '@type': 'WebPage',
  '@id': `${canonical}#pagina`,
  url: canonical,
  name: title,
  description,
  inLanguage: seo.lingua,
  isPartOf: { '@id': `${urlBase}/#sito` },
  about: { '@id': idOrg },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
};

// Home: la FAQ. Le pagine Calabria e mondo: il loro elenco di viaggi.
const nodiFaq = [
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.domanda,
        acceptedAnswer: { '@type': 'Answer', text: f.risposta },
      })),
    },
];

const nodiKalabria = [
    {
      '@type': 'ItemList',
      '@id': `${canonical}#viaggi-in-calabria`,
      name: 'Viaggi in Calabria: trekking ed escursioni Xploring Kalabria',
      itemListElement: [...prossimi, ...passati].map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: viaggio(e, 'Calabria'),
      })),
    },
];

const nodiMondo = [
    {
      '@type': 'ItemList',
      '@id': `${canonical}#viaggi-di-gruppo`,
      name: 'Viaggi di gruppo organizzati nel mondo',
      itemListElement: viaggiMondo.map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: viaggio(e, 'mondo'),
      })),
    },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    ...nodiSempre,
    nodoPagina,
    ...(nodi ?? (elenco === 'kalabria' ? nodiKalabria : elenco === 'mondo' ? nodiMondo : nodiFaq)),
  ],
};
---

<!doctype html>
<html lang={seo.lingua} class={`pole-${pole}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content={`${seo.persona.nome} (${seo.persona.alias})`} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Geo: l'attività ha un luogo fisico, la Calabria. -->
    <meta name="geo.region" content={seo.geo.regione} />
    <meta name="geo.placename" content={seo.geo.luogo} />
    <meta name="geo.position" content={`${seo.geo.lat};${seo.geo.lon}`} />
    <meta name="ICBM" content={`${seo.geo.lat}, ${seo.geo.lon}`} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Xploring: viaggi di gruppo nel mondo e viaggi in Calabria" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Archivo:ital,wdth,wght@0,125,400..700;1,125,400..700&display=swap"
    />
    <meta name="theme-color" content="#F3E7CE" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

    <!-- Le animazioni allo scroll partono da opacity:0: senza JS resterebbe tutto invisibile. -->
    <noscript>
      <style>
        .reveal,
        .reveal-stagger > * {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a href="#contenuto" class="skip">Vai al contenuto</a>
    <Header />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />

    <style>
      .skip {
        position: absolute;
        left: 1rem;
        top: -4rem;
        z-index: 100;
        background: var(--color-accent);
        color: var(--color-accent-ink);
        padding: 0.6rem 1rem;
        font-weight: 600;
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
        font-size: 0.74rem;
        transition: top 0.2s ease;
      }
      .skip:focus {
        top: 1rem;
      }
    </style>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document
        .querySelectorAll('.reveal, .reveal-stagger')
        .forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
