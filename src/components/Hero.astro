---
import { site, CALABRIA } from '../data/site';
import { totalePaesi, continenti } from '../data/paesi';

const scrivi = `https://wa.me/${site.telefonoRaw}?text=${encodeURIComponent(
  'Ciao NorPeppe! Vorrei informazioni sui prossimi viaggi ed eventi.'
)}`;
---

<section class="hero" id="home">
  <div class="aurora" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>

  <div class="stage">
    <img class="mark" src="/images/logo-x.png" alt="Logo Xploring Kalabria" width="193" height="265" />

    <h1 class="lockup">
      <span class="wordmark display">Xploring</span>
      <span class="sub script">con NorPeppe</span>
      <span class="sr-only">— viaggi di gruppo nel mondo e viaggi in Calabria</span>
    </h1>

    <p class="claim">{site.claim}</p>

    <a class="btn btn-solid cta" href={scrivi} target="_blank" rel="noopener noreferrer">
      Scrivimi su WhatsApp
    </a>

    <div class="doors">
      <a class="door pole-mondo" href="#mondo">
        <span class="door-meta mono">{totalePaesi} paesi · {continenti.length} continenti</span>
        <span class="door-title display">Viaggi di gruppo<br />nel mondo</span>
        <span class="door-desc">
          Gruppi piccoli, itinerari che non trovi a catalogo. Si parte insieme.
        </span>
        <span class="door-cta">Scopri i viaggi <span aria-hidden="true">→</span></span>
      </a>

      <a class="door pole-kalabria" href="#kalabria">
        <span class="door-meta mono">38°54′N 16°30′E · {CALABRIA.label}</span>
        <span class="door-title display">Xploring<br />Kalabria</span>
        <span class="door-desc">
          Trekking, canyon, borghi e serate. Il calendario di casa mia.
        </span>
        <span class="door-cta">Guarda il calendario <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </div>

  <a class="scroll-cue" href="#mappa">
    <span class="mono">Dove sono stato</span>
    <span class="chevron" aria-hidden="true">⌄</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 7rem var(--pad-inline) 4.5rem;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(5, 8, 7, 0.55) 0%, rgba(6, 10, 9, 0.72) 60%, var(--color-bg) 100%),
      url('/images/hero-aurora.jpg') center/cover no-repeat;
  }

  .aurora {
    position: absolute;
    inset: -10% -10% 45% -10%;
    background: linear-gradient(
      120deg,
      transparent 20%,
      rgba(79, 216, 196, 0.4) 45%,
      rgba(120, 235, 180, 0.22) 60%,
      transparent 80%
    );
    filter: blur(48px);
    animation: drift 16s ease-in-out infinite alternate;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 80% at 50% 40%, transparent 40%, rgba(4, 6, 5, 0.75) 100%);
    pointer-events: none;
  }

  @keyframes drift {
    from { transform: translateX(-4%) scaleY(1); }
    to { transform: translateX(4%) scaleY(1.08); }
  }

  .stage {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1000px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .mark {
    width: clamp(52px, 6vw, 74px);
    height: auto;
    opacity: 0.92;
    filter: drop-shadow(0 4px 18px rgba(0, 0, 0, 0.6));
    animation: markIn 1s ease both;
  }

  .lockup {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 0.9rem;
  }

  .wordmark {
    font-size: clamp(3rem, 11vw, 7.5rem);
    letter-spacing: 0.1em;
    /* Anton è già stretto: l'aria tra le lettere fa il resto. */
    text-indent: 0.1em;
    line-height: 0.9;
    text-shadow: 0 6px 40px rgba(0, 0, 0, 0.65);
    animation: markIn 1s 0.1s ease both;
  }

  .sub {
    font-size: clamp(1.4rem, 3.4vw, 2.2rem);
    color: var(--c-mondo);
    margin-top: -0.1em;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.7);
    animation: markIn 1s 0.2s ease both;
  }

  .claim {
    margin-top: 1.1rem;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    color: var(--color-text);
    letter-spacing: 0.02em;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.75);
    animation: markIn 1s 0.3s ease both;
  }

  .cta {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    animation: markIn 1s 0.4s ease both;
  }

  .doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    width: 100%;
    margin-top: clamp(2rem, 4vw, 3.25rem);
    text-align: left;
    animation: markIn 1s 0.45s ease both;
  }

  .door {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: clamp(1.2rem, 2.5vw, 1.75rem);
    background: rgba(6, 9, 8, 0.62);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-accent-dim);
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s ease, background 0.3s ease;
  }

  /* Il colore del polo entra dal basso: è la porta che si apre. */
  .door::before {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }

  .door:hover,
  .door:focus-visible {
    border-color: var(--color-accent);
    background: rgba(8, 12, 10, 0.78);
    transform: translateY(-3px);
  }

  .door:hover::before,
  .door:focus-visible::before {
    transform: scaleX(1);
  }

  .door-meta {
    color: var(--color-accent);
    opacity: 0.85;
  }

  .door-title {
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 0.95;
  }

  .door-desc {
    color: var(--color-text-muted);
    font-size: 0.98rem;
    max-width: 34ch;
  }

  .door-cta {
    margin-top: 0.35rem;
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .door:hover .door-cta span {
    display: inline-block;
    animation: nudge 0.6s ease;
  }

  .scroll-cue {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    margin-top: clamp(1.75rem, 4vw, 3rem);
    color: var(--color-text-muted);
    transition: color 0.25s ease;
  }

  .scroll-cue:hover {
    color: var(--color-text);
  }

  .chevron {
    font-size: 1.3rem;
    line-height: 1;
    animation: bob 2.2s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @keyframes markIn {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes nudge {
    50% { transform: translateX(4px); }
  }

  @media (max-width: 760px) {
    .doors {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-top: 6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora,
    .chevron,
    .mark,
    .wordmark,
    .sub,
    .claim,
    .cta,
    .doors {
      animation: none;
    }
  }
</style>
