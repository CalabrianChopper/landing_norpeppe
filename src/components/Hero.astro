---
import { site, CALABRIA } from '../data/site';
import { totalePaesi, continenti } from '../data/paesi';

const scrivi = `https://wa.me/${site.telefonoRaw}?text=${encodeURIComponent(
  'Ciao Xploring! Vorrei informazioni sui prossimi viaggi ed eventi.'
)}`;
---

<section class="hero" id="home">
  <div class="foto-fondo" aria-hidden="true"></div>
  <div class="aurora" aria-hidden="true"></div>
  <div class="velo" aria-hidden="true"></div>

  <div class="stage">
    <img class="mark" src="/images/logo-x.png" alt="Logo Xploring Kalabria" width="193" height="265" />

    <h1 class="lockup">
      <span class="wordmark display">Xploring</span>
      <span class="sr-only">— viaggi di gruppo nel mondo e viaggi in Calabria</span>
    </h1>

    <p class="claim">{site.claim}</p>

    <a class="btn btn-solid cta" href={scrivi} target="_blank" rel="noopener noreferrer">
      Scrivimi su WhatsApp
    </a>

    <div class="doors">
      <a class="door pole-mondo" href="/mondo/">
        <span class="door-meta mono">{totalePaesi} paesi · {continenti.length} continenti</span>
        <span class="door-title display">Viaggi di gruppo<br />nel mondo</span>
        <span class="door-desc">
          Gruppi piccoli, itinerari che non trovi a catalogo. Si parte insieme.
        </span>
        <span class="door-cta">Scopri i viaggi <span aria-hidden="true">→</span></span>
      </a>

      <a class="door pole-kalabria" href="/kalabria/">
        <span class="door-meta mono">38°54′N 16°30′E · {CALABRIA.label}</span>
        <span class="door-title display">Xploring<br />Kalabria</span>
        <span class="door-desc">
          Trekking, canyon, borghi e serate. Il calendario in Calabria.
        </span>
        <span class="door-cta">Guarda il calendario <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </div>

  <a class="scroll-cue" href="#mappa">
    <span class="mono">Dove sono stato</span>
    <span class="chevron" aria-hidden="true">⌄</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 7rem var(--pad-inline) 4.5rem;
    overflow: hidden;
    background: var(--color-bg);
  }

  /* La foto notturna resta, ma velata: sulla carta panna diventa una filigrana
     verde-oliva, non un fondale scuro. */
  .foto-fondo {
    position: absolute;
    inset: 0;
    background: url('/images/hero-aurora.jpg') center / cover no-repeat;
    filter: grayscale(0.45) sepia(0.6) brightness(1.55) contrast(0.66);
    opacity: 0.32;
    pointer-events: none;
  }

  .aurora {
    position: absolute;
    inset: -10% -10% 45% -10%;
    background: linear-gradient(
      120deg,
      transparent 20%,
      rgba(110, 122, 58, 0.3) 45%,
      rgba(210, 113, 43, 0.16) 60%,
      transparent 80%
    );
    filter: blur(48px);
    animation: drift 16s ease-in-out infinite alternate;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  /* Dissolvenza verso la carta: in basso la sezione deve finire in panna piena. */
  .velo {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(115% 80% at 50% 38%, rgba(243, 231, 206, 0.5) 30%, rgba(243, 231, 206, 0.86) 100%),
      linear-gradient(180deg, transparent 40%, rgba(243, 231, 206, 0.9) 78%, var(--color-bg) 100%);
    pointer-events: none;
  }

  @keyframes drift {
    from { transform: translateX(-4%) scaleY(1); }
    to { transform: translateX(4%) scaleY(1.08); }
  }

  .stage {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1000px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Il monogramma nasce bianco: qui va riportato all'inchiostro. */
  .mark {
    width: clamp(52px, 6vw, 74px);
    height: auto;
    filter: brightness(0) saturate(100%);
    opacity: 0.86;
    animation: markIn 1s ease both;
  }

  .lockup {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 0.9rem;
  }

  .wordmark {
    font-size: clamp(2.1rem, 7vw, 5rem);
    /* Alfa Slab One riempie già: niente aria in più fra le lettere. */
    letter-spacing: 0.01em;
    text-indent: 0.01em;
    line-height: 1;
    color: var(--color-text);
    animation: markIn 1s 0.1s ease both;
  }

  .sub {
    font-size: clamp(1.05rem, 2.2vw, 1.5rem);
    color: var(--c-kalabria-deep);
    margin-top: -0.1em;
    animation: markIn 1s 0.2s ease both;
  }

  .claim {
    margin-top: 1.1rem;
    font-size: clamp(0.98rem, 1.6vw, 1.15rem);
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
    animation: markIn 1s 0.3s ease both;
  }

  .cta {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    animation: markIn 1s 0.4s ease both;
  }

  .doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    width: 100%;
    margin-top: clamp(2rem, 4vw, 3.25rem);
    text-align: left;
    animation: markIn 1s 0.45s ease both;
  }

  .door {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: clamp(1.2rem, 2.5vw, 1.75rem);
    background: rgba(251, 244, 227, 0.78);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-accent-dim);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s ease, background 0.3s ease,
      box-shadow 0.3s ease;
  }

  /* Il colore del polo entra dal basso: è la porta che si apre. */
  .door::before {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: var(--color-accent-bright);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }

  .door:hover,
  .door:focus-visible {
    border-color: var(--color-accent);
    background: rgba(251, 244, 227, 0.95);
    box-shadow: var(--shadow-lift);
    transform: translateY(-3px);
  }

  .door:hover::before,
  .door:focus-visible::before {
    transform: scaleX(1);
  }

  .door-meta {
    color: var(--color-accent);
  }

  .door-title {
    font-size: clamp(1.15rem, 2.2vw, 1.6rem);
    line-height: 1.02;
    color: var(--color-text);
  }

  .door-desc {
    color: var(--color-text-muted);
    font-size: 0.93rem;
    max-width: 34ch;
  }

  .door-cta {
    margin-top: 0.35rem;
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .door:hover .door-cta span {
    display: inline-block;
    animation: nudge 0.6s ease;
  }

  .scroll-cue {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    margin-top: clamp(1.75rem, 4vw, 3rem);
    color: var(--color-text-muted);
    transition: color 0.25s ease;
  }

  .scroll-cue:hover {
    color: var(--color-text);
  }

  .chevron {
    font-size: 1.3rem;
    line-height: 1;
    animation: bob 2.2s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @keyframes markIn {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes nudge {
    50% { transform: translateX(4px); }
  }

  @media (max-width: 760px) {
    .doors {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-top: 6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora,
    .chevron,
    .mark,
    .wordmark,
    .sub,
    .claim,
    .cta,
    .doors {
      animation: none;
    }
  }
</style>
