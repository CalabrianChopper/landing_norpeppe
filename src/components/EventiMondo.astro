---
import EventoCard from './EventoCard.astro';
import { prossimiMondo as prossimi, passatiMondo as passati } from '../data/viaggiMondo';
import { site } from '../data/site';
---

<section class="section eventi eventi-mondo pole-mondo" id="calendario">
  <div class="wrap">
    <div class="testa reveal">
      <div>
        <p class="eyebrow">Il calendario nel mondo</p>
        <h2 class="display titolo">Prossimi viaggi di gruppo organizzati</h2>
      </div>
      <p class="intro">
        Le partenze si formano quando c’è il gruppo. Qui trovi dove si va e
        dove siamo già stati: scegli, scrivimi, e vediamo se la data combacia.
      </p>
    </div>

    <div class="tabs reveal" role="tablist" aria-label="Filtra i viaggi">
      <button
        class="tab is-active"
        id="tab-mondo-prossimi"
        role="tab"
        aria-selected="true"
        aria-controls="pannello-mondo-prossimi"
        type="button"
      >
        In arrivo <span class="conta">{prossimi.length}</span>
      </button>
      <button
        class="tab"
        id="tab-mondo-passati"
        role="tab"
        aria-selected="false"
        aria-controls="pannello-mondo-passati"
        type="button"
      >
        Già fatti <span class="conta">{passati.length}</span>
      </button>
    </div>

    <div class="pannello" id="pannello-mondo-prossimi" role="tabpanel" aria-labelledby="tab-mondo-prossimi">
      <div class="griglia reveal-stagger">
        {prossimi.map((e) => <EventoCard evento={e} />)}
      </div>

      <div class="coda">
        <p class="nota">
          Le date escono quando il gruppo c’è. Scrivimi e ti avviso appena si apre una partenza.
        </p>
        <a
          class="btn btn-solid"
          href={`https://wa.me/${site.telefonoRaw}?text=${encodeURIComponent('Ciao NorPeppe! Avvisami quando escono le date dei prossimi viaggi nel mondo.')}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Avvisami sulle partenze
        </a>
      </div>
    </div>

    <div class="pannello" id="pannello-mondo-passati" role="tabpanel" aria-labelledby="tab-mondo-passati" hidden>
      <p class="nota nota-alta">
        Dove siamo già stati. Se una di queste mete ti interessa, dimmelo:
        si riparte quando c’è un gruppo.
      </p>
      <div class="elenco reveal">
        {passati.map((e) => <EventoCard evento={e} variante="riga" />)}
      </div>
    </div>
  </div>
</section>

<style>
  .eventi {
    background: var(--color-bg);
    border-top: 1px solid var(--color-accent-dim);
  }

  .testa {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(280px, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: end;
    margin-bottom: 2.25rem;
  }

  .titolo {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    margin-top: 0.4rem;
  }

  .intro {
    color: var(--color-text-muted);
    max-width: 46ch;
  }

  .tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    padding: 0.75rem 1.15rem;
    margin-bottom: -1px;
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .tab:first-child {
    padding-left: 0;
  }

  .tab:hover {
    color: var(--color-text);
  }

  .tab.is-active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .conta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    opacity: 0.7;
  }

  .griglia {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.25rem;
  }

  .coda {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .nota {
    color: var(--color-text-muted);
    max-width: 48ch;
  }

  .nota-alta {
    margin-bottom: 1.5rem;
  }

  .elenco {
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 860px) {
    .testa {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>

<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.eventi-mondo .tab')
  );

  const attiva = (scelto: HTMLButtonElement) => {
    tabs.forEach((t) => {
      const on = t === scelto;
      t.classList.toggle('is-active', on);
      t.setAttribute('aria-selected', String(on));
      const pannello = document.getElementById(t.getAttribute('aria-controls')!);
      if (pannello) pannello.hidden = !on;
    });
  };

  tabs.forEach((t) => t.addEventListener('click', () => attiva(t)));
</script>
