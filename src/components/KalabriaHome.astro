---
import EventoCard from './EventoCard.astro';
import { prossimi, passati, percheKalabria } from '../data/eventi';
import { site } from '../data/site';

const inVetrina = prossimi.slice(0, 3);
const scrivi = `https://wa.me/${site.telefonoRaw}?text=${encodeURIComponent(
  'Ciao NorPeppe! Vorrei essere avvisato sui prossimi eventi in Calabria.'
)}`;
---

<section class="section kal pole-kalabria" id="kalabria">
  <div class="wrap">
    <!-- Intro: stessa struttura di Xploring the World, foto a destra per specchiarla. -->
    <div class="intro grid">
      <div class="testo reveal">
        <p class="eyebrow">Viaggi in Calabria</p>
        <h2 class="display titolo">Xploring<br />Kalabria</h2>
        <p class="lead">
          Trekking in Calabria dentro i canyon, notti in tenda, borghi aperti col DJ set in
          terrazza. Non è promozione turistica: è la mia regione fatta a piedi,
          con chi ha voglia di venire. Ogni uscita è un gruppo aperto: si
          scrive, si prenota, ci si trova al punto di ritrovo.
        </p>

        <ul class="punti">
          {percheKalabria.map((p) => (
            <li>
              <span class="punto-chiave mono">{p.chiave}</span>
              <span class="punto-testo">{p.titolo}</span>
            </li>
          ))}
        </ul>

        <div class="azioni">
          <a class="btn btn-solid" href={scrivi} target="_blank" rel="noopener noreferrer">
            Fammi sapere le date
          </a>
          <a class="link-underline" href="#mondo">E se invece vuoi partire lontano</a>
        </div>
      </div>

      <figure class="foto reveal">
        <img
          src="/images/to-calabria.jpg"
          alt="Trekking in Calabria con Xploring Kalabria: un vicolo di un borgo sul mare"
          loading="lazy"
        />
        <figcaption class="mono">
          {passati.length} uscite già fatte · {prossimi.length} in arrivo
        </figcaption>
      </figure>
    </div>

    <div class="testa reveal">
      <p class="eyebrow">Le prossime uscite</p>
      <h3 class="display sottotitolo">Trekking ed escursioni in Calabria in arrivo</h3>
    </div>

    <div class="griglia reveal-stagger">
      {inVetrina.map((e) => <EventoCard evento={e} />)}
    </div>

    <div class="coda reveal">
      <a class="btn" href={scrivi} target="_blank" rel="noopener noreferrer">Voglio esserci alla prossima</a>
      <a class="link-underline" href="#calendario">Oppure guarda le partenze nel mondo</a>
    </div>
  </div>
</section>

<style>
  .kal {
    background:
      radial-gradient(80% 60% at 10% 0%, rgba(255, 122, 60, 0.08), transparent 70%),
      var(--color-bg);
    border-top: 1px solid var(--color-accent-dim);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.1fr minmax(260px, 0.9fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .foto {
    margin: 0;
  }

  .foto img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--color-border);
  }

  .foto figcaption {
    margin-top: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }

  .titolo {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    margin-block: 0.4rem 1rem;
  }

  .punti {
    list-style: none;
    margin-block: 1.75rem;
    border-top: 1px solid var(--color-border);
  }

  .punti li {
    display: grid;
    grid-template-columns: minmax(96px, 22%) 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .punto-chiave {
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .punto-testo {
    font-size: 1.02rem;
    color: var(--color-text);
  }

  .azioni {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .testa {
    margin-bottom: 1.5rem;
  }

  .sottotitolo {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    margin-top: 0.3rem;
  }

  .griglia {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.25rem;
  }

  .coda {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .foto {
      max-width: 380px;
      order: -1;
    }
  }

  @media (max-width: 520px) {
    .punti li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
