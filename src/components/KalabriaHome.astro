---
import { prossimi, passati, percheKalabria } from '../data/eventi';
import { site } from '../data/site';

---

<section class="section kal pole-kalabria" id="kalabria">
  <div class="wrap">
    <!-- Intro: stessa struttura di Xploring the World, foto a destra per specchiarla. -->
    <div class="intro grid">
      <div class="testo reveal">
        <p class="eyebrow">Viaggi in Calabria</p>
        <h2 class="display titolo">Xploring<br />Kalabria</h2>
        <p class="lead">
          Trekking in Calabria dentro i canyon, notti in tenda, borghi aperti col DJ set in
          terrazza. Non è promozione turistica: è la nostra regione fatta a piedi,
          con chi ha voglia di venire. Ogni uscita è un gruppo aperto: si
          scrive, si prenota, ci si trova al punto di ritrovo.
        </p>

        <ul class="punti">
          {percheKalabria.map((p) => (
            <li>
              <span class="punto-chiave mono">{p.chiave}</span>
              <span class="punto-testo">{p.titolo}</span>
            </li>
          ))}
        </ul>

        <div class="azioni">
          <a class="btn btn-solid" href="#calendario-kalabria">Guarda le prossime uscite</a>
        </div>
      </div>

      <figure class="foto reveal">
        <img
          src="/images/kalabria-gruppo.jpg"
          alt="Il gruppo di Xploring Kalabria in un bosco calabrese, con lo striscione"
          loading="lazy"
        />
        <figcaption class="mono">
          {passati.length} uscite già fatte · {prossimi.length} in arrivo
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .kal {
    background:
      radial-gradient(80% 60% at 10% 0%, rgba(210, 113, 43, 0.13), transparent 70%),
      var(--color-bg);
    border-top: 1px solid var(--color-accent-dim);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.1fr minmax(260px, 0.9fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .foto {
    margin: 0;
  }

  .foto img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* La foto di gruppo: le persone e lo striscione stanno in basso. */
    object-position: center 80%;
    border: 1px solid var(--color-border);
  }

  .foto figcaption {
    margin-top: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .titolo {
    font-size: clamp(1.75rem, 3.6vw, 2.8rem);
    margin-block: 0.5rem 1rem;
  }

  .punti {
    list-style: none;
    margin-block: 1.75rem;
    border-top: 1px solid var(--color-border);
  }

  .punti li {
    display: grid;
    grid-template-columns: minmax(130px, 27%) 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .punto-chiave {
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .punto-testo {
    font-size: 0.97rem;
    color: var(--color-text);
  }

  .azioni {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .foto {
      max-width: 380px;
      order: -1;
    }
  }

  @media (max-width: 520px) {
    .punti li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
