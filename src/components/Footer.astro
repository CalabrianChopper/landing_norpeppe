---
import { site, scriviMail } from '../data/site';

const anno = new Date().getFullYear();

const social = [
  { nome: 'Instagram', href: site.social.instagram, icona: 'instagram' },
  { nome: 'Facebook', href: site.social.facebook, icona: 'facebook' },
  { nome: 'TikTok', href: site.social.tiktok, icona: 'tiktok' },
];
---

<footer class="footer" id="contatti">
  <div class="split">
    <div class="panel contatti">
      <p class="eyebrow">Contatti</p>
      <h2 class="display titolo">Parliamone</h2>
      <p class="corpo">
        Se hai una domanda, un’idea o un gruppo già formato, scrivici!
      </p>

      <ul class="dettagli">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li class="mono">{site.luogo}</li>
      </ul>

      <div class="socials">
        {social.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.nome}
            class="social-link"
          >
            {s.icona === 'instagram' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
                <circle cx="12" cy="12" r="4.3" />
                <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
              </svg>
            )}
            {s.icona === 'facebook' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M15 8.5h-2c-.8 0-1.3.5-1.3 1.3V12h3.1l-.4 3h-2.7v7h-3v-7H8.5v-3h2.1V9.3c0-2.2 1.3-3.8 3.6-3.8H15z" />
              </svg>
            )}
            {s.icona === 'tiktok' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path
                  d="M14 3.5c.6 2 2.1 3.3 4.2 3.5v2.6c-1.5 0-2.9-.5-4.2-1.4v6.4a5.1 5.1 0 1 1-4.4-5.1v2.7a2.5 2.5 0 1 0 1.8 2.4V3.5z"
                  stroke-linejoin="round"
                />
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <div class="panel scelte">
      <p class="eyebrow">Da dove vuoi cominciare</p>

      <a class="scelta pole-mondo" href="/mondo/">
        <span class="scelta-titolo display">Parto nel mondo</span>
        <span class="scelta-nota">Viaggi di gruppo, in pochi e organizzati</span>
        <span class="freccia" aria-hidden="true">→</span>
      </a>

      <a class="scelta pole-kalabria" href="/kalabria/">
        <span class="scelta-titolo display">Resto in Calabria</span>
        <span class="scelta-nota">Eventi ed escursioni tutto l’anno</span>
        <span class="freccia" aria-hidden="true">→</span>
      </a>

      <a class="btn btn-solid diretto" href={scriviMail('Informazioni da xploringkalabria.it')}>
        Scrivici una mail
      </a>
    </div>
  </div>

  <div class="bottom-bar">
    <p>© {anno} {site.brand}</p>
    <p>
      Made with love &#x2661; by
      <a href="https://www.ttbusiness.it" target="_blank" rel="noopener noreferrer">TTB</a>
    </p>
    <!-- TODO: agganciare le pagine legali vere quando ci sono. -->
      <p><a href="#">Privacy Policy</a> · <a href="#">Cookie Policy</a></p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-raised);
    border-top: 1px solid var(--color-border-strong);
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .panel {
    padding: clamp(2rem, 5vw, 4rem);
  }

  .contatti {
    background: linear-gradient(160deg, var(--c-mondo-soft) 0%, #f2ebd6 100%);
  }

  .scelte {
    background: linear-gradient(200deg, var(--c-kalabria-soft) 0%, #f8ecd7 100%);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .titolo {
    font-size: clamp(1.4rem, 2.8vw, 2.1rem);
    margin-block: 0.45rem 1rem;
  }

  .corpo {
    color: var(--color-text-muted);
    max-width: 40ch;
    margin-bottom: 1.5rem;
  }

  .dettagli {
    list-style: none;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .dettagli li {
    margin-bottom: 0.35rem;
  }

  .dettagli a {
    transition: color 0.25s ease;
  }

  .dettagli a:hover {
    color: var(--c-mondo-deep);
  }

  .socials {
    display: flex;
    gap: 0.75rem;
  }

  .social-link {
    width: 34px;
    height: 34px;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--color-text-muted);
    transition: transform 0.25s ease, border-color 0.25s ease, color 0.25s ease,
      background-color 0.25s ease;
  }

  .social-link svg {
    width: 16px;
    height: 16px;
  }

  .social-link:hover {
    color: var(--c-mondo-ink);
    background-color: var(--c-mondo-deep);
    border-color: var(--c-mondo-deep);
    transform: translateY(-3px);
  }

  .scelta {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.25rem 1rem;
    padding: 1.1rem 1.25rem;
    background: rgba(251, 244, 227, 0.55);
    border: 1px solid var(--color-accent-dim);
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .scelta:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-raised);
    box-shadow: var(--shadow-soft);
    transform: translateX(4px);
  }

  .scelta-titolo {
    font-size: 1.15rem;
    line-height: 1.05;
  }

  .scelta-nota {
    grid-column: 1;
    color: var(--color-text-muted);
    font-size: 0.87rem;
  }

  .freccia {
    grid-row: 1 / span 2;
    grid-column: 2;
    color: var(--color-accent);
    font-size: 1.3rem;
  }

  .diretto {
    align-self: flex-start;
    margin-top: 0.6rem;
  }

  .bottom-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1rem clamp(1.25rem, 5vw, 3rem);
    font-size: 0.78rem;
    color: var(--color-text-faint);
    border-top: 1px solid var(--color-border);
  }

  .bottom-bar a:hover {
    color: var(--color-text);
  }

  @media (max-width: 800px) {
    .split {
      grid-template-columns: 1fr;
    }
    .bottom-bar {
      flex-direction: column;
      gap: 0.4rem;
      text-align: center;
      align-items: center;
    }
  }
</style>
