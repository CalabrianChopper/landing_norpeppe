---
import { site } from '../data/site';
import { perche, formato } from '../data/viaggi';

const scrivi = `https://wa.me/${site.telefonoRaw}?text=${encodeURIComponent(
  'Ciao Xploring! Vorrei informazioni sui viaggi di gruppo nel mondo.'
)}`;
---

<section class="section mondo pole-mondo" id="mondo">
  <div class="wrap grid">
    <figure class="foto reveal">
      <img
        src="/images/from-calabria.jpg"
        alt="Viaggi di gruppo nel mondo con Xploring: il gruppo in cammino"
        loading="lazy"
      />
      <figcaption class="mono">{formato.gruppo} · {formato.partenzeAnno}</figcaption>
    </figure>

    <div class="testo reveal">
      <p class="eyebrow">Viaggi di gruppo nel mondo</p>
      <h2 class="display titolo">Xploring<br />the World</h2>
      <p class="lead">
        Si parte in pochi, verso posti che ho già camminato. Nessun pullman,
        nessuna guida col microfono: gli itinerari nascono dalle persone che ho
        conosciuto là, e sono loro ad aprirci la porta.
      </p>

      <ul class="punti">
        {perche.map((p) => (
          <li>
            <span class="punto-chiave mono">{p.chiave}</span>
            <span class="punto-testo">{p.titolo}</span>
          </li>
        ))}
      </ul>

      <div class="azioni">
        <a class="btn btn-solid" href={scrivi} target="_blank" rel="noopener noreferrer">
          Parliamo del prossimo viaggio
        </a>
        <a class="link-underline" href="#calendario">
          Guarda le prossime partenze
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .mondo {
    background: var(--color-bg-sunk);
    border-top: 1px solid var(--color-accent-dim);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(260px, 0.9fr) 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .foto {
    margin: 0;
  }

  .foto img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--color-border);
  }

  .foto figcaption {
    margin-top: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .titolo {
    font-size: clamp(1.75rem, 3.6vw, 2.8rem);
    margin-block: 0.5rem 1rem;
  }

  .punti {
    list-style: none;
    margin-block: 1.75rem;
    border-top: 1px solid var(--color-border);
  }

  .punti li {
    display: grid;
    grid-template-columns: minmax(130px, 27%) 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .punto-chiave {
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .punto-testo {
    font-size: 0.97rem;
    color: var(--color-text);
  }

  .azioni {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .foto {
      max-width: 380px;
    }
  }

  @media (max-width: 520px) {
    .punti li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
