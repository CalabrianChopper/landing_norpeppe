---
// Il calendario, uguale per i due poli: schede delle uscite in arrivo,
// elenco di quelle già fatte. Cambiano i dati e i testi, non la forma.
// Solo la Calabria passa `conPagina`: lì ogni uscita, in arrivo o già fatta, ha la sua pagina.
import EventoCard from './EventoCard.astro';
import { urlEvento, type Evento } from '../data/eventi';

interface Props {
  /** Ancora della sezione, es. 'calendario'. */
  id: string;
  pole: 'mondo' | 'kalabria';
  eyebrow: string;
  titolo: string;
  intro: string;
  prossimi: Evento[];
  passati: Evento[];
  /** Riga sopra l'elenco dei già fatti. */
  notaPassati: string;
  /** Riga in coda alle schede in arrivo, accanto al bottone. */
  notaProssimi: string;
  cta: { label: string; href: string };
  /** Se vero, schede e righe portano alla pagina dell'uscita invece che a WhatsApp. */
  conPagina?: boolean;
}

const {
  id,
  pole,
  eyebrow,
  titolo,
  intro,
  prossimi,
  passati,
  notaPassati,
  notaProssimi,
  cta,
  conPagina = false,
} = Astro.props;

const idProssimi = `pannello-${id}-prossimi`;
const idPassati = `pannello-${id}-passati`;
---

<section class={`section calendario pole-${pole}`} id={id}>
  <div class="wrap">
    <div class="testa reveal">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="display titolo">{titolo}</h2>
      </div>
      <p class="intro">{intro}</p>
    </div>

    <div class="tabs reveal" role="tablist" aria-label={`Filtra: ${titolo}`}>
      <button
        class="tab is-active"
        id={`tab-${id}-prossimi`}
        role="tab"
        aria-selected="true"
        aria-controls={idProssimi}
        type="button"
      >
        In arrivo <span class="conta">{prossimi.length}</span>
      </button>
      <button
        class="tab"
        id={`tab-${id}-passati`}
        role="tab"
        aria-selected="false"
        aria-controls={idPassati}
        type="button"
      >
        Già fatti <span class="conta">{passati.length}</span>
      </button>
    </div>

    <div class="pannello" id={idProssimi} role="tabpanel" aria-labelledby={`tab-${id}-prossimi`}>
      <div class="griglia reveal-stagger">
        {prossimi.map((e) => (
          <EventoCard evento={e} href={conPagina ? urlEvento(e) : undefined} />
        ))}
      </div>

      <div class="coda">
        <p class="nota">{notaProssimi}</p>
        <a
          class="btn btn-solid"
          href={cta.href}
          target={cta.href.startsWith('http') ? '_blank' : undefined}
          rel={cta.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          {cta.label}
        </a>
      </div>
    </div>

    <div class="pannello" id={idPassati} role="tabpanel" aria-labelledby={`tab-${id}-passati`} hidden>
      <p class="nota nota-alta">{notaPassati}</p>
      <div class="elenco reveal">
        {passati.map((e) => (
          <EventoCard evento={e} variante="riga" href={conPagina ? urlEvento(e) : undefined} />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .calendario {
    background: var(--color-bg);
    border-top: 1px solid var(--color-accent-dim);
  }

  .testa {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(280px, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: end;
    margin-bottom: 2.25rem;
  }

  .titolo {
    font-size: clamp(1.55rem, 3.2vw, 2.4rem);
    margin-top: 0.5rem;
  }

  .intro {
    color: var(--color-text-muted);
    max-width: 46ch;
  }

  .tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.76rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    padding: 0.75rem 1.15rem;
    margin-bottom: -1px;
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .tab:first-child {
    padding-left: 0;
  }

  .tab:hover {
    color: var(--color-text);
  }

  .tab.is-active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .conta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    opacity: 0.7;
  }

  .griglia {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.25rem;
  }

  .coda {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .nota {
    color: var(--color-text-muted);
    max-width: 48ch;
  }

  .nota-alta {
    margin-bottom: 1.5rem;
  }

  .elenco {
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 860px) {
    .testa {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>

<script>
  // Un solo script per tutti i calendari della pagina: si va per aria-controls.
  document.querySelectorAll<HTMLElement>('.calendario .tabs').forEach((gruppo) => {
    const tabs = Array.from(gruppo.querySelectorAll<HTMLButtonElement>('.tab'));

    const attiva = (scelto: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === scelto;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
        const pannello = document.getElementById(t.getAttribute('aria-controls')!);
        if (!pannello) return;
        pannello.hidden = !on;
        // Un pannello nascosto non incrocia mai il viewport, quindi le sue
        // rivelazioni allo scroll resterebbero a opacity 0 per sempre.
        if (on) {
          pannello
            .querySelectorAll('.reveal, .reveal-stagger')
            .forEach((el) => el.classList.add('is-visible'));
        }
      });
    };

    tabs.forEach((t) => t.addEventListener('click', () => attiva(t)));
  });
</script>
