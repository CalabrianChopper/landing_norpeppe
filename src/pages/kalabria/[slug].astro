---
// La pagina di una singola uscita in Calabria. Il contenuto sta in
// src/components/PaginaUscita.astro, uguale per Calabria e mondo.
import PaginaUscita from '../../components/PaginaUscita.astro';
import { conPagina, prossimi, type Evento } from '../../data/eventi';

export function getStaticPaths() {
  return conPagina.map((evento) => ({
    params: { slug: evento.slug },
    props: { evento },
  }));
}

interface Props {
  evento: Evento;
}

const { evento } = Astro.props;
---

<PaginaUscita evento={evento} altre={prossimi} />
